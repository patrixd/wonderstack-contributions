{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonderstackai.com/schema/community/training.schema.json",
  "title": "WonderStack free training (front matter of training/<slug>.md)",
  "description": "A free course, video, guide or exercise that teaches a tool for a job. The description below the front matter is Apache 2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "url",
    "tools",
    "job",
    "level",
    "duration_minutes",
    "licence",
    "cost"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "url": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "pattern": "^https://[^\\s<>\"]+$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{2,40}$"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "job": {
      "type": "string",
      "pattern": "^[a-z0-9_]{2,40}$",
      "description": "A job id from the WonderStack jobs taxonomy (see CONTRIBUTING.md)."
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6000
    },
    "licence": {
      "enum": [
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC0-1.0",
        "MIT",
        "Apache-2.0",
        "free-to-access"
      ]
    },
    "cost": {
      "const": "free",
      "description": "Only free training is accepted (no paywall, no trial that ends in a charge)."
    },
    "format": {
      "enum": [
        "course",
        "video",
        "article",
        "guide",
        "exercise",
        "docs"
      ]
    },
    "language": {
      "enum": [
        "en",
        "es",
        "fr",
        "de",
        "pt",
        "it",
        "other"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^@?[A-Za-z0-9][A-Za-z0-9_-]{0,38}$",
      "description": "Optional public handle of the person who added it."
    }
  }
}
